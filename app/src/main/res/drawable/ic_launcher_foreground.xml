        android:fillColor="#C9A96E"
        android:pathData="
            M54,22 L57,51 L86,54 L57,57 L54,86
            L51,57 L22,54 L51,51 Z" />

    <!-- Center dot (drawn as path — <circle> is not valid in VectorDrawable) -->
